{
	"$schema"       : "./node_modules/@angular/cli/lib/config/schema.json",
	"version"       : 1,
	"newProjectRoot": "projects",
	"projects"      : {
		"ionic-angular-multi-locale-ssr": {
			"projectType": "application",
			"schematics" : {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root"       : "",
			"sourceRoot" : "src",
			"prefix"     : "app",
			"i18n"       : {
				"locales": {
					"en"     : {
						"translation": "src/i18n/xlf/messages.en.xlf",
						"subPath"    : "en"
					},
					"zh-Hans": {
						"translation": "src/i18n/xlf/messages.zhs.xlf",
						"subPath"    : "zhs"
					},
					"zh-Hant": {
						"translation": "src/i18n/xlf/messages.zht.xlf",
						"subPath"    : "zht"
					}
				}
			},
			"architect"  : {
				"build"              : {
					"builder"             : "@angular-devkit/build-angular:application",
					"options"             : {
						"baseHref"           : "/",
						"localize"           : ["en", "zh-Hans", "zh-Hant"],
						"outputPath"         : {
							"base"   : "dist",
							"browser": "browser",
							"server" : "server"
						},
						"index"              : "src/index.html",
						"browser"            : "src/main.ts",
						"polyfills"          : [
							"zone.js",
							"@angular/localize/init"
						],
						"tsConfig"           : "tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets"             : [
							{
								"glob" : "**/*",
								"input": "public"
							}
						],
						"styles"             : [
							"src/style/styles.scss"
						],
						"scripts"            : [],
						"server"             : "src/main.server.ts",
						"outputMode"         : "server",
						"ssr"                : {
							"entry": "src/server.ts"
						}
					},
					"configurations"      : {
						"production" : {
							"budgets"      : [
								{
									"type"          : "initial",
									"maximumWarning": "500kB",
									"maximumError"  : "1MB"
								},
								{
									"type"          : "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError"  : "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"baseHref"       : "/zht/",
							"localize"       : ["zh-Hant"],
							"optimization"   : false,
							"extractLicenses": false,
							"sourceMap"      : true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve"              : {
					"builder"             : "@angular-devkit/build-angular:dev-server",
					"configurations"      : {
						"production" : {
							"buildTarget": "ionic-angular-multi-locale-ssr:build:production"
						},
						"development": {
							"buildTarget": "ionic-angular-multi-locale-ssr:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"extract-i18n"       : {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test"               : {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills"          : [
							"zone.js",
							"zone.js/testing",
							"@angular/localize/init"
						],
						"tsConfig"           : "tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets"             : [
							{
								"glob" : "**/*",
								"input": "public"
							}
						],
						"styles"             : [
							"src/style/styles.scss"
						],
						"scripts"            : []
					}
				},
				"ionic-cordova-build": {
					"builder"       : "@ionic/angular-toolkit:cordova-build",
					"options"       : {
						"browserTarget": "ionic-angular-multi-locale-ssr:build"
					},
					"configurations": {
						"production": {
							"browserTarget": "ionic-angular-multi-locale-ssr:build:production"
						}
					}
				},
				"ionic-cordova-serve": {
					"builder"       : "@ionic/angular-toolkit:cordova-serve",
					"options"       : {
						"cordovaBuildTarget": "ionic-angular-multi-locale-ssr:ionic-cordova-build",
						"devServerTarget"   : "ionic-angular-multi-locale-ssr:serve"
					},
					"configurations": {
						"production": {
							"cordovaBuildTarget": "ionic-angular-multi-locale-ssr:ionic-cordova-build:production",
							"devServerTarget"   : "ionic-angular-multi-locale-ssr:serve:production"
						}
					}
				}
			}
		}
	},
	"cli"           : {
		"schematicCollections": [
			"@ionic/angular-toolkit"
		]
	},
	"schematics"    : {
		"@ionic/angular-toolkit:component": {
			"styleext": "scss"
		},
		"@ionic/angular-toolkit:page"     : {
			"styleext": "scss"
		}
	}
}
